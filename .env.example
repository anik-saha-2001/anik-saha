# ── Admin login (your own custom auth — nothing to do with Supabase) ──────
ADMIN_PASSWORD=change-me
# Generate with: openssl rand -hex 32
ADMIN_SESSION_SECRET=change-me-too-please-use-a-long-random-string

# ── Supabase (free tier) — where content, settings and the CV live ───────
# Project Settings → API in your Supabase dashboard.
# SUPABASE_URL is the "Project URL". SUPABASE_SERVICE_ROLE_KEY is the
# "service_role" secret key (NOT the "anon public" key — the service role
# key is what lets the admin panel write; it must never be exposed to the
# browser, which is why it has no NEXT_PUBLIC_ prefix).
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
